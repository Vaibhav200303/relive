rediscoverMomentCount:
SELECT COUNT(*) FROM moments;

favoriteMomentCount:
SELECT COUNT(*) FROM moments WHERE is_favorite = 1;

selectFavoriteMoments:
SELECT * FROM moments
WHERE is_favorite = 1
ORDER BY created_at DESC, id DESC;

selectFavoriteVisualAttachments:
SELECT a.* FROM media_attachments a
JOIN moments m ON m.id = a.moment_id
WHERE m.is_favorite = 1
  AND a.media_type IN ('Image', 'Video')
ORDER BY m.created_at DESC, m.id DESC, a.sort_index ASC
LIMIT :limit;

-- SQLite's localtime conversion intentionally follows the device's current local
-- calendar, matching Relive's existing editorial date formatters.
selectOnThisDayCore:
SELECT
    m.*,
    CAST(strftime('%Y', m.created_at / 1000, 'unixepoch', 'localtime') AS INTEGER) AS local_year
FROM moments m
WHERE CAST(strftime('%m', m.created_at / 1000, 'unixepoch', 'localtime') AS INTEGER) = :month
  AND CAST(strftime('%d', m.created_at / 1000, 'unixepoch', 'localtime') AS INTEGER) = :day
  AND CAST(strftime('%Y', m.created_at / 1000, 'unixepoch', 'localtime') AS INTEGER) < :year
  AND m.created_at < :startOfToday
ORDER BY m.created_at DESC, m.id DESC
LIMIT 20;

-- Four evenly spaced positions in a deterministic daily rotation. The selected
-- rows stay bounded while SQLite performs the archive ordering locally.
selectPastRediscoveryCore:
SELECT
    m.*,
    CAST(strftime('%Y', m.created_at / 1000, 'unixepoch', 'localtime') AS INTEGER) AS local_year
FROM moments m
JOIN (
WITH eligible AS (
    SELECT m.id, m.created_at
    FROM moments m
    WHERE m.created_at <= :recentCutoff
      AND m.created_at < :startOfToday
      AND (
          CAST(strftime('%m', m.created_at / 1000, 'unixepoch', 'localtime') AS INTEGER) != :month
          OR CAST(strftime('%d', m.created_at / 1000, 'unixepoch', 'localtime') AS INTEGER) != :day
          OR CAST(strftime('%Y', m.created_at / 1000, 'unixepoch', 'localtime') AS INTEGER) >= :year
      )
), numbered AS (
    SELECT id, created_at, ROW_NUMBER() OVER (ORDER BY created_at DESC, id DESC) - 1 AS position
    FROM eligible
), counts AS (
    SELECT COUNT(*) AS total FROM eligible
), slots(slot) AS (
    VALUES (0), (1), (2), (3)
), targets AS (
    SELECT
        slots.slot,
        (
            (:dailySeed % CASE WHEN counts.total > 0 THEN counts.total ELSE 1 END) +
            (slots.slot * counts.total) /
                CASE WHEN counts.total < 4 THEN CASE WHEN counts.total > 0 THEN counts.total ELSE 1 END ELSE 4 END
        ) % CASE WHEN counts.total > 0 THEN counts.total ELSE 1 END AS position
    FROM counts
    CROSS JOIN slots
    WHERE slots.slot < CASE WHEN counts.total < 4 THEN counts.total ELSE 4 END
)
SELECT n.id, targets.slot
FROM targets
JOIN numbered n ON n.position = targets.position
) selected ON selected.id = m.id
ORDER BY selected.slot ASC;

selectRediscoverAttachmentsForMomentIds:
SELECT * FROM media_attachments
WHERE moment_id IN :momentIds
ORDER BY moment_id ASC, sort_index ASC;

selectRediscoverTagsForMomentIds:
SELECT mt.moment_id, t.canonical, t.label
FROM moment_tags mt
JOIN tags t ON t.canonical = mt.tag_canonical
WHERE mt.moment_id IN :momentIds
ORDER BY mt.moment_id ASC, t.canonical ASC;

selectRediscoverPlaces:
WITH place_moments AS (
    SELECT
        m.id AS moment_id,
        TRIM(COALESCE(
            NULLIF(TRIM(m.location_locality), ''),
            NULLIF(TRIM(m.location_display_name), ''),
            NULLIF(TRIM(m.location_region), ''),
            NULLIF(TRIM(m.location_country), '')
        )) AS label
    FROM moments m
), grouped AS (
    SELECT
        LOWER(label) AS place_key,
        MIN(label) AS label,
        COUNT(DISTINCT moment_id) AS moment_count
    FROM place_moments
    WHERE label IS NOT NULL AND label <> ''
    GROUP BY label COLLATE NOCASE
)
SELECT place_key, label, moment_count
FROM grouped
ORDER BY moment_count DESC, place_key ASC
LIMIT 6;

selectRediscoverTags:
SELECT
    t.canonical,
    COUNT(DISTINCT mt.moment_id) AS moment_count
FROM tags t
JOIN moment_tags mt ON mt.tag_canonical = t.canonical
GROUP BY t.canonical
ORDER BY moment_count DESC, t.canonical ASC
LIMIT 12;
