CREATE TABLE moments (
    id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL,
    updated_at INTEGER,
    title TEXT NOT NULL DEFAULT '',
    content TEXT NOT NULL DEFAULT '',
    is_favorite INTEGER NOT NULL DEFAULT 0,
    location_lat REAL,
    location_lon REAL,
    location_display_name TEXT,
    location_locality TEXT,
    location_region TEXT,
    location_country TEXT
);

CREATE INDEX moments_created_at ON moments(created_at);
CREATE INDEX moments_updated_at ON moments(updated_at);

insertMoment:
INSERT INTO moments (
    id, created_at, updated_at,
    title, content, is_favorite,
    location_lat, location_lon,
    location_display_name, location_locality, location_region, location_country
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMomentById:
SELECT * FROM moments WHERE id = :id;

selectAllMoments:
SELECT * FROM moments ORDER BY created_at DESC, id DESC;

-- Bounded head window for the Home surface's All moments feed (ADR-0061). The root must never
-- observe or hydrate the complete archive, so Home reads this instead of selectAllMoments and
-- grows :limit by one page as the person scrolls toward older Moments.
selectAllMomentsWindow:
SELECT * FROM moments ORDER BY created_at DESC, id DESC LIMIT :limit;

-- Total archive size, so a loaded window knows whether older Moments remain.
countAllMoments:
SELECT COUNT(*) FROM moments;

-- Cheap change-detector for the archive: enough to notice an insert or a delete without reading a
-- single row. `created_at` is immutable, so the archive's shape is fully described by its size and
-- its extremes. Used for Rediscover reminder scheduling, which previously hydrated every Moment.
selectAllMomentsFingerprint:
SELECT COUNT(*) AS moment_count,
       COALESCE(MAX(created_at), 0) AS newest_created_at,
       COALESCE(MIN(created_at), 0) AS oldest_created_at
FROM moments;

-- Zero-based position of a Moment in the newest-first ordering, used to size the window when the
-- surface is re-anchored at a Moment resolved by Calendar navigation or Search.
countMomentsNewerThan:
SELECT COUNT(*) FROM moments
WHERE created_at > :createdAt OR (created_at = :createdAt AND id > :id);

selectMomentsMatchingQuery:
SELECT * FROM moments
WHERE title LIKE '%' || :query || '%' COLLATE NOCASE
   OR content LIKE '%' || :query || '%' COLLATE NOCASE
ORDER BY created_at DESC, id DESC;

selectMomentsInTimeline:
SELECT m.* FROM moments m
JOIN moment_timeline_memberships mtm ON mtm.moment_id = m.id
WHERE mtm.timeline_id = :timelineId
ORDER BY m.created_at DESC, m.id DESC;

selectFirstMomentOnOrAfterInAll:
SELECT * FROM moments
WHERE created_at >= :start AND created_at < :end
ORDER BY created_at ASC, id ASC
LIMIT 1;

selectFirstMomentAfterInAll:
SELECT * FROM moments
WHERE created_at >= :start
ORDER BY created_at ASC, id ASC
LIMIT 1;

selectLastMomentBeforeInAll:
SELECT * FROM moments
WHERE created_at < :end
ORDER BY created_at DESC, id DESC
LIMIT 1;

selectFirstMomentOnOrAfterInTimeline:
SELECT m.* FROM moments m
JOIN moment_timeline_memberships mtm ON mtm.moment_id = m.id
WHERE mtm.timeline_id = :timelineId AND m.created_at >= :start AND m.created_at < :end
ORDER BY m.created_at ASC, m.id ASC
LIMIT 1;

selectFirstMomentAfterInTimeline:
SELECT m.* FROM moments m
JOIN moment_timeline_memberships mtm ON mtm.moment_id = m.id
WHERE mtm.timeline_id = :timelineId AND m.created_at >= :start
ORDER BY m.created_at ASC, m.id ASC
LIMIT 1;

selectLastMomentBeforeInTimeline:
SELECT m.* FROM moments m
JOIN moment_timeline_memberships mtm ON mtm.moment_id = m.id
WHERE mtm.timeline_id = :timelineId AND m.created_at < :end
ORDER BY m.created_at DESC, m.id DESC
LIMIT 1;

updateMomentEditableFields:
UPDATE moments SET
    updated_at = :updatedAt,
    title = :title,
    content = :content,
    location_lat = :locationLat,
    location_lon = :locationLon,
    location_display_name = :locationDisplayName,
    location_locality = :locationLocality,
    location_region = :locationRegion,
    location_country = :locationCountry
WHERE id = :id;

updateFavorite:
UPDATE moments SET is_favorite = :isFavorite WHERE id = :id;

deleteMoment:
DELETE FROM moments WHERE id = :id;

countMoments:
SELECT COUNT(*) FROM moments;

deleteAllMoments:
DELETE FROM moments;
