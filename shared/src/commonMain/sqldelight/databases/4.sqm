-- `moments` predates SQLDelight's tracked migration snapshot, which starts at
-- profile_metadata, so the guarded create lets migration verification reconstruct the
-- older schema exactly as 2.sqm does for custom_timelines. It is a no-op on every
-- existing Relive database.
CREATE TABLE IF NOT EXISTS moments (
    id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL,
    updated_at INTEGER,
    title TEXT NOT NULL DEFAULT '',
    content TEXT NOT NULL DEFAULT '',
    is_favorite INTEGER NOT NULL DEFAULT 0,
    location_lat REAL,
    location_lon REAL,
    location_display_name TEXT,
    location_locality TEXT,
    location_region TEXT,
    location_country TEXT
);

-- The optional post-save reflection (ADR-0066). Nullable with no default, so every
-- existing Moment stays unfelt and nothing is ever backfilled.
ALTER TABLE moments ADD COLUMN feeling TEXT;
