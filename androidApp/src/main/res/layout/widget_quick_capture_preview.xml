<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview shown in the widget picker (API 31+). The live widget is rendered by Glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_quick_capture_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="20dp">

    <TextView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_accent_badge"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Capture a moment"
            android:textColor="#17184B"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Add today to your archive"
            android:textColor="#55567A"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
