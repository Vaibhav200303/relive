<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ReliveRevenueCatPublicApiKey</key>
    <string>$(RELIVE_REVENUECAT_IOS_PUBLIC_API_KEY)</string>
    <key>ReliveTermsOfServiceUrl</key>
    <string>$(RELIVE_TERMS_OF_SERVICE_URL)</string>
    <key>RelivePrivacyPolicyUrl</key>
    <string>$(RELIVE_PRIVACY_POLICY_URL)</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Relive uses the microphone only while you record a voice memory.</string>
	<key>NSCameraUsageDescription</key>
	<string>Relive uses the camera only when you capture a photo or video for a moment.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Relive imports selected photos and videos from your library into your local memory archive.</string>
</dict>
</plist>
