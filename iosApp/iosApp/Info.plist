<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ReliveRevenueCatPublicApiKey</key>
    <string>$(RELIVE_REVENUECAT_IOS_PUBLIC_API_KEY)</string>
    <key>ReliveTermsOfServiceUrl</key>
    <string>$(RELIVE_TERMS_OF_SERVICE_URL)</string>
    <key>RelivePrivacyPolicyUrl</key>
    <string>$(RELIVE_PRIVACY_POLICY_URL)</string>
    <key>ReliveSupportEmail</key>
    <string>$(RELIVE_SUPPORT_EMAIL)</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Relive uses the microphone only while you record a voice memory.</string>
	<key>NSCameraUsageDescription</key>
	<string>Relive uses the camera only when you capture a photo or video for a moment.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Relive imports selected photos and videos from your library into your local memory archive.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Relive saves the photos and videos you choose back to your media library.</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.vaibhav.relive.archive</string>
			<key>UTTypeDescription</key>
			<string>Relive Portable Archive</string>
			<key>UTTypeConformsTo</key>
			<array><string>public.zip-archive</string><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>relive</string></array>
				<key>public.mime-type</key><string>application/vnd.vaibhav.relive.archive</string>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>Relive Portable Archive</string>
			<key>LSHandlerRank</key><string>Owner</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSItemContentTypes</key><array><string>com.vaibhav.relive.archive</string></array>
		</dict>
	</array>
</dict>
</plist>
